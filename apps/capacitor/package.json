{
  "name": "@collectio/capacitor-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "test": "echo 'tests not configured yet'",
    "clean": "npx rimraf -g dist *.tsbuildinfo",
