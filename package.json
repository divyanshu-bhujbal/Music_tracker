{
  "name": "collectio",
  "private": true,
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.8.4",
    "typescript-eslint": "8.61.1"
  },
  "scripts": {
    "dev:electron": "pnpm --filter @collectio/electron-app dev",
    "dev:capacitor": "pnpm --filter @collectio/capacitor-app dev",
    "build:electron": "pnpm --filter @collectio/electron-app build",
    "build:capacitor": "pnpm --filter @collectio/capacitor-app build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "clean": "pnpm -r clean"
  },
  "dependencies": {
  }
}
